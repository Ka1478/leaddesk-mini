{
  "name": "leaddesk-mini",
  "version": "1.0.0",
  "description": "Lead capture and management application built with Express.js, Node.js, React, HTML, CSS, JavaScript, and MongoDB",
  "main": "server/index.js",
  "scripts": {
    "install-all": "npm install && cd client && npm install",
    "seed": "node server/seed.js",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "dev": "node server/index.js"
  },
  "keywords": ["lead-management", "express", "react", "mongodb", "fullstack"],
  "author": "Digital Heroes",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "mongodb-memory-server": "^9.2.0"
  }
}
